# ---------------------------------------------------------------------------
# yt-playlist-studio configuration
#
# Copy to .env and fill in only what you need. .env is gitignored - never commit it.
#
#   Reading a PUBLIC or UNLISTED playlist needs NOTHING in this file.
#   You only need credentials to read a PRIVATE playlist, or to write to YouTube.
# ---------------------------------------------------------------------------

# --- Optional: official Data API for reads -------------------------------
# A plain API key can read public/unlisted playlists. It CANNOT write, and it
# CANNOT read private playlists. Only used when YTPS_PREFER_API=true.
# Get one: https://console.cloud.google.com/apis/credentials
YT_API_KEY=

# --- Required only for private reads and ALL writes ----------------------
# OAuth 2.0 client of type "Desktop app". Consent happens in your own browser;
# this tool never sees your Google password.
# Setup walkthrough: docs/auth-setup.md
YT_OAUTH_CLIENT_ID=
YT_OAUTH_CLIENT_SECRET=

# Where the refresh token is cached (gitignored, chmod 600 on write).
YT_OAUTH_TOKEN_PATH=.tokens/token.json

# Leave blank for a "Desktop app" client (it accepts any loopback port - simplest).
# Set a port ONLY if you are reusing an existing "Web application" client, and add
# http://localhost:<port>/ to that client's Authorised redirect URIs in the console.
YT_OAUTH_PORT=

# --- Behaviour -----------------------------------------------------------
# Use the Data API for reads instead of the free keyless reader. Costs quota.
YTPS_PREFER_API=false

# Your project's daily quota. Default Google allowance is 10000 units/day.
# Adding one song costs 50 units, so 10000 = about 200 song-adds per day.
YTPS_DAILY_QUOTA=10000

YTPS_STATE_DIR=.ytps
YTPS_OUTPUT_DIR=out

# --- Optional: LLM-assisted tagging --------------------------------------
# Only read if you register an LLM provider and run `ytps tag --llm`.
ANTHROPIC_API_KEY=
